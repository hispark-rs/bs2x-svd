    <peripheral>
      <name>WDT</name>
      <description>Watchdog timer (v151)</description>
      <baseAddress>0x52003000</baseAddress>
      <addressBlock>
        <offset>0x0000</offset>
        <size>0x1000</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>WDT_LOCK</name>
          <description>Watchdog lock register</description>
          <addressOffset>0x00</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>wdt_lock</name>
              <description>Write 0x5A5A5A5A to unlock, other values lock</description>
              <bitRange>[31:0]</bitRange>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>WDT_LOAD</name>
          <description>Watchdog load value</description>
          <addressOffset>0x04</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>wdt_load</name>
              <description>Load count value (24-bit, low 8 bits reserved)</description>
              <bitRange>[31:8]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>WDT_RESTART</name>
          <description>Watchdog restart register</description>
          <addressOffset>0x08</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>wdt_restart</name>
              <description>Write anything except 0x5A5A5A5A to restart counter</description>
              <bitRange>[31:0]</bitRange>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>WDT_EOI</name>
          <description>Watchdog interrupt clear (read to clear)</description>
          <addressOffset>0x0C</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>wdt_eoi</name>
              <description>Read to clear watchdog interrupt</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>WDT_CR</name>
          <description>Watchdog control register</description>
          <addressOffset>0x10</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>wdt_en</name>
              <description>Watchdog enable: 0=disabled; 1=enabled</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>rst_en</name>
              <description>Reset enable: 0=no reset on timeout; 1=reset on timeout</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>rst_pl</name>
              <description>Reset pulse length: 000=2 clocks; up to 111=256 clocks</description>
              <bitRange>[5:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>wdt_imsk</name>
              <description>Interrupt mask: 0=unmasked; 1=masked</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>wdt_mode</name>
              <description>Mode: 0=one interrupt then reset; 1=two interrupts then reset</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Mode1</name>
                  <description>Single interrupt then reset</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Mode2</name>
                  <description>Two interrupts then reset</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>WDT_CNT</name>
          <description>Watchdog current counter value</description>
          <addressOffset>0x14</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>wdt_cnt</name>
              <description>Current counter value</description>
              <bitRange>[31:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>WDT_RAW_INTR</name>
          <description>Watchdog raw interrupt status</description>
          <addressOffset>0x18</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>wdt_raw_intr</name>
              <description>Raw interrupt status</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>WDT_INTR</name>
          <description>Watchdog interrupt status (masked)</description>
          <addressOffset>0x1C</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>wdt_intr</name>
              <description>Interrupt status after mask</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>WDT_LPIF_STATE</name>
          <description>Watchdog low power state</description>
          <addressOffset>0x20</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>wdt_lpif_state</name>
              <description>Low power interface state</description>
              <bitRange>[2:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>WDT_STATUS</name>
          <description>Watchdog status</description>
          <addressOffset>0x24</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>wdt_status</name>
              <description>Status: 0=busy; 1=free</description>
              <bitRange>[0:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>WDT_CCVR_EN</name>
          <description>Watchdog counter value request</description>
          <addressOffset>0x28</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>ccvr_req</name>
              <description>Write 1 to request current counter value</description>
              <bitRange>[0:0]</bitRange>
              <access>write-only</access>
            </field>
            <field>
              <name>ccvr_ack</name>
              <description>Acknowledge: 1=counter value valid</description>
              <bitRange>[1:1]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
