    <peripheral>
      <name>SPI0</name>
      <description>SPI0 master/slave controller (SSI v151)</description>
      <baseAddress>0x52087000</baseAddress>
      <addressBlock>
        <offset>0x0000</offset>
        <size>0x0100</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>SPI_ER</name>
          <description>SPI enable register</description>
          <addressOffset>0x00</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>spi_en</name>
              <description>SPI enable: 0=disabled; 1=enabled</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>SPI_CTRA</name>
          <description>SPI control register 0</description>
          <addressOffset>0x04</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>soe</name>
              <description>Shift register loop test: 0=normal; 1=loopback</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>scph</name>
              <description>Clock phase: 0=first edge sample; 1=second edge sample</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>FirstEdge</name>
                  <description>Sample on first clock edge</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SecondEdge</name>
                  <description>Sample on second clock edge</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>scpol</name>
              <description>Clock polarity: 0=low idle; 1=high idle</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>LowIdle</name>
                  <description>SCK idle low</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HighIdle</name>
                  <description>SCK idle high</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>dfs32</name>
              <description>Data frame size in 32-bit mode (0=4bit; up to 31=35bit)</description>
              <bitRange>[17:13]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>trsm</name>
              <description>Transfer mode: 00=TX/RX; 01=TX only; 10=RX only</description>
              <bitRange>[19:18]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>TxRx</name>
                  <description>Transmit and Receive</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TxOnly</name>
                  <description>Transmit Only</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RxOnly</name>
                  <description>Receive Only</description>
                  <value>2</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>SPI_CTRB</name>
