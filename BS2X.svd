<?xml version='1.0' encoding='utf-8'?>
<device xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" schemaVersion="1.3" xsi:noNamespaceSchemaLocation="CMSIS-SVD.xsd">
  <name>BS2X</name>
  <version>0.1</version>
  <description>HiSilicon BS21 / BS2X BLE 5.4 + SLE/NearLink SoC — ISA: rv32i2p1_m2p0_f2p2_c2p0_zicsr2p0 (RV32IMFC_Zicsr), 64MHz app core, 512KB ITCM, 160KB L2RAM, 1MB XIP flash @0x10000000. Shares WS63's HimiDeer riscv31 core + versioned IP (UART v151/TIMER v150/GPIO v150).</description>
  <licenseText>Register definitions derived from public ws63-guide documentation and fbb_ws63 HAL
    headers. See https://github.com/hispark-rs/ws63-guide and
    https://github.com/hispark-rs/ws63-svd</licenseText>
  <cpu>
    <name>other</name>
    <revision>r0p0</revision>
    <endian>little</endian>
    <mpuPresent>true</mpuPresent>
    <fpuPresent>true</fpuPresent>
    <fpuDP>false</fpuDP>
    <dspPresent>false</dspPresent>
    <nvicPrioBits>3</nvicPrioBits>
    <vendorSystickConfig>false</vendorSystickConfig>
  </cpu>
  <addressUnitBits>8</addressUnitBits>
  <width>32</width>
  <size>32</size>
  <access>read-write</access>
  <resetValue>0x0</resetValue>
  <resetMask>0xFFFFFFFF</resetMask>
  <peripherals>
    <peripheral>
      <name>GLB_CTL_M</name>
      <description>Main core global control - BCPU/MCPU reset status, chip reset, AON CRG</description>
      <baseAddress>0x57000000</baseAddress>
      <addressBlock>
        <offset>0x0000</offset>
        <size>0x0200</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>BCPU_RESET_STS</name>
          <description>BCPU reset status register</description>
          <addressOffset>0x0030</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>bcpu_reset_sts</name>
              <description>BCPU reset status</description>
              <bitRange>[31:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>MCPU_RESET_STS</name>
          <description>MCPU reset status register</description>
          <addressOffset>0x0034</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>mcpu_reset_sts</name>
              <description>MCPU reset status</description>
              <bitRange>[31:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>RESET_STS_CLEAR</name>
          <description>Reset status clear register</description>
          <addressOffset>0x003C</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>rst_sts_clear</name>
              <description>Write 0xFF to clear all reset status bits</description>
              <bitRange>[31:0]</bitRange>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>AON_CRG_CKEN_CTL</name>
          <description>AON CRG clock enable control</description>
          <addressOffset>0x0100</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>wdt_gate</name>
              <description>WDT clock gate control at bit[4]</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>CHIP_RESET</name>
          <description>Chip reset control register</description>
          <addressOffset>0x0110</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>chip_reset_en</name>
              <description>Chip reset enable: 1=assert chip reset</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>AON_SOFT_RST_CTL</name>
          <description>AON soft reset control</description>
          <addressOffset>0x0110</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>wdt_soft_rst</name>
              <description>WDT soft reset at bit[1]</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
      </registers>
      <interrupt>
        <name>BT_INT0</name>
        <description>BT_INT0 (IRQ 26)</description>
        <value>26</value>
      </interrupt>
      <interrupt>
        <name>BT_INT1</name>
        <description>BT_INT1 (IRQ 27)</description>
        <value>27</value>
      </interrupt>
      <interrupt>
        <name>MCU_PCLR_LOCK</name>
        <description>MCU_PCLR_LOCK (IRQ 32)</description>
        <value>32</value>
      </interrupt>
      <interrupt>
        <name>BT_TOGGLE_POS</name>
        <description>BT_TOGGLE_POS (IRQ 36)</description>
        <value>36</value>
      </interrupt>
      <interrupt>
        <name>BT_TOGGLE_NEG</name>
        <description>BT_TOGGLE_NEG (IRQ 37)</description>
        <value>37</value>
      </interrupt>
      <interrupt>
        <name>MCU_SIMO1P1_VSET</name>
        <description>MCU_SIMO1P1_VSET (IRQ 40)</description>
        <value>40</value>
      </interrupt>
      <interrupt>
        <name>QSPI0_2CS</name>
        <description>QSPI0_2CS (IRQ 43)</description>
        <value>43</value>
      </interrupt>
      <interrupt>
        <name>M_WAKEUP</name>
        <description>M_WAKEUP (IRQ 47)</description>
        <value>47</value>
      </interrupt>
      <interrupt>
        <name>M_SLEEP</name>
        <description>M_SLEEP (IRQ 48)</description>
        <value>48</value>
      </interrupt>
      <interrupt>
        <name>BT_BB_BT</name>
        <description>BT_BB_BT (IRQ 64)</description>
        <value>64</value>
      </interrupt>
      <interrupt>
        <name>BT_BB_BLE</name>
        <description>BT_BB_BLE (IRQ 65)</description>
        <value>65</value>
      </interrupt>
      <interrupt>
        <name>BT_BB_GLE</name>
        <description>BT_BB_GLE (IRQ 66)</description>
        <value>66</value>
      </interrupt>
      <interrupt>
        <name>I2S</name>
        <description>I2S (IRQ 67)</description>
        <value>67</value>
      </interrupt>
      <interrupt>
        <name>RF_PRT</name>
        <description>RF_PRT (IRQ 68)</description>
        <value>68</value>
      </interrupt>
      <interrupt>
        <name>NFC</name>
        <description>NFC (IRQ 69)</description>
        <value>69</value>
      </interrupt>
      <interrupt>
        <name>OSC_EN_WKUP</name>
        <description>OSC_EN_WKUP (IRQ 73)</description>
        <value>73</value>
      </interrupt>
      <interrupt>
        <name>OSC_EN_SLEEP</name>
        <description>OSC_EN_SLEEP (IRQ 74)</description>
        <value>74</value>
      </interrupt>
      <interrupt>
        <name>PMU_CMU_ERR</name>
        <description>PMU_CMU_ERR (IRQ 78)</description>
        <value>78</value>
      </interrupt>
      <interrupt>
        <name>ULP_INT</name>
        <description>ULP_INT (IRQ 79)</description>
        <value>79</value>
      </interrupt>
      <interrupt>
        <name>PMU2_CLK_32K_CALI</name>
        <description>PMU2_CLK_32K_CALI (IRQ 85)</description>
        <value>85</value>
      </interrupt>
      <interrupt>
        <name>ULP_WKUP_INT</name>
        <description>ULP_WKUP_INT (IRQ 86)</description>
        <value>86</value>
      </interrupt>
      <interrupt>
        <name>TSENSOR</name>
        <description>TSENSOR (IRQ 87)</description>
        <value>87</value>
      </interrupt>
    </peripheral>
    <peripheral>
      <name>GPIO0</name>
      <description>GPIO controller for GPIO[7:0]</description>
      <baseAddress>0x57010000</baseAddress>
      <addressBlock>
        <offset>0x0000</offset>
        <size>0x1000</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>GPIO_SW_OUT</name>
          <description>GPIO data register</description>
          <addressOffset>0x0000</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>gpio_sw_out</name>
              <description>GPIO data. Output: written value drives I/O; Input: reads external port</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>GPIO_SW_OEN</name>
          <description>GPIO data direction register</description>
          <addressOffset>0x0004</addressOffset>
          <resetValue>0x000000FF</resetValue>
          <fields>
            <field>
              <name>gpio_sw_oen</name>
              <description>GPIO direction: 0=output; 1=input (default)</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Output</name>
                  <description>Output direction</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Input</name>
                  <description>Input direction</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>GPIO_INT_EN</name>
          <description>GPIO interrupt enable register</description>
          <addressOffset>0x000C</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>gpio_int_en</name>
              <description>Interrupt enable: 0=normal GPIO; 1=interrupt port</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>GPIO_INT_MASK</name>
          <description>GPIO interrupt mask register</description>
          <addressOffset>0x0010</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>gpio_int_mask</name>
              <description>Interrupt mask: 0=not masked; 1=masked</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>GPIO_INT_TYPE</name>
          <description>GPIO interrupt type register</description>
          <addressOffset>0x0014</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>gpio_int_type</name>
              <description>Interrupt type: 0=level; 1=edge</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Level</name>
                  <description>Level-sensitive</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Edge</name>
                  <description>Edge-triggered</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>GPIO_INT_POLARITY</name>
          <description>GPIO interrupt polarity register</description>
          <addressOffset>0x0018</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>gpio_int_polarity</name>
              <description>Interrupt polarity: 0=low/falling; 1=high/rising</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>LowFalling</name>
                  <description>Low level or falling edge</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HighRising</name>
                  <description>High level or rising edge</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>GPIO_INT_DEDGE</name>
          <description>GPIO dual-edge interrupt enable register</description>
          <addressOffset>0x001C</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>gpio_int_dedge</name>
              <description>Dual-edge interrupt enable: 0=disabled; 1=enabled</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disabled</name>
                  <description>Single-edge mode</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enabled</name>
                  <description>Dual-edge triggered</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>GPIO_INT_DEBOUNCE</name>
          <description>GPIO interrupt debounce control register</description>
          <addressOffset>0x0020</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>gpio_int_debounce</name>
              <description>Debounce enable: 0=disabled; 1=enabled</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>GPIO_INT_RAW</name>
          <description>GPIO raw interrupt status register</description>
          <addressOffset>0x0024</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>gpio_int_raw</name>
              <description>Raw interrupt status (before mask): 0=no interrupt; 1=interrupt</description>
              <bitRange>[7:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>GPIO_INTR</name>
          <description>GPIO interrupt status register</description>
          <addressOffset>0x0028</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>gpio_intr</name>
              <description>Interrupt status (after mask): 0=no interrupt; 1=interrupt</description>
              <bitRange>[7:0]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>GPIO_INT_EOI</name>
          <description>GPIO interrupt clear register</description>
          <addressOffset>0x002C</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>gpio_int_eoi</name>
              <description>Edge interrupt clear: 0=no clear; 1=clear interrupt</description>
              <bitRange>[7:0]</bitRange>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>GPIO_DATA_SET</name>
          <description>GPIO data set register</description>
          <addressOffset>0x0030</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>gpio_data_set</name>
              <description>Write 1 to set corresponding GPIO_SW_OUT bits</description>
              <bitRange>[7:0]</bitRange>
              <access>write-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>GPIO_DATA_CLR</name>
          <description>GPIO data clear register</description>
          <addressOffset>0x0034</addressOffset>
          <resetValue>0x00000000</resetValue>
          <fields>
            <field>
              <name>gpio_data_clr</name>
              <description>Write 1 to clear corresponding GPIO_SW_OUT bits</description>
              <bitRange>[7:0]</bitRange>
              <access>write-only</access>
            </field>
          </fields>
        </register>
      </registers>
      <interrupt>
        <name>GPIO_0</name>
        <description>GPIO_0 (IRQ 34)</description>
        <value>34</value>
      </interrupt>
    </peripheral>
    <peripheral>
      <name>UART0</name>
      <description>UART0 - Universal Asynchronous Receiver/Transmitter</description>
      <baseAddress>0x52081000</baseAddress>
      <addressBlock>
        <offset>0x0000</offset>
        <size>0x1000</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>INTR_ID</name>
          <description>Interrupt ID register</description>
          <addressOffset>0x00</addressOffset>
          <size>16</size>
          <resetValue>0x0001</resetValue>
          <fields>
            <field>
              <name>intr_id</name>
              <description>Interrupt ID: 0x0=modem status; 0x1=no interrupt; 0x2=THR empty; 0x4=rx
                data; 0x6=rx line status; 0x7=busy; 0xC=char timeout</description>
              <bitRange>[3:0]</bitRange>
              <access>read-only</access>
            </field>
            <field>
              <name>fifo_en_s</name>
              <description>FIFO enable status: 0=FIFO disabled; 1=FIFO enabled</description>
              <bitRange>[4:4]</bitRange>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DATA</name>
          <description>Data register</description>
          <addressOffset>0x04</addressOffset>
          <size>16</size>
          <resetValue>0x0000</resetValue>
          <fields>
            <field>
              <name>data</name>
              <description>Write: TX data; Read: RX data</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>UART_CTL</name>
          <description>UART control register</description>
          <addressOffset>0x08</addressOffset>
          <size>16</size>
          <resetValue>0x0000</resetValue>
          <fields>
            <field>
              <name>div_en</name>
              <description>Divider enable: 0=div accessible when not busy; 1=div accessible anytime</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>xbreak</name>
              <description>Break control: 0=normal; 1=force TX to space</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>dlen</name>
              <description>Data length: 00=5bit; 01=6bit; 10=7bit; 11=8bit</description>
              <bitRange>[3:2]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Bits5</name>
                  <description>5-bit data</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Bits6</name>
                  <description>6-bit data</description>
                  <value>1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Bits7</name>
                  <description>7-bit data</description>
                  <value>2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Bits8</name>
                  <description>8-bit data</description>
                  <value>3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>eps</name>
              <description>Parity select: 0=odd; 1=even</description>
              <bitRange>[4:4]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Odd</name>
                  <description>Odd parity</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Even</name>
                  <description>Even parity</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>pen</name>
              <description>Parity enable: 0=disabled; 1=enabled</description>
              <bitRange>[5:5]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Disabled</name>
                  <description>No parity</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Enabled</name>
                  <description>Parity enabled</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>sps</name>
              <description>Sticky parity: 0=disabled; 1=enabled</description>
              <bitRange>[6:6]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>stp</name>
              <description>Stop bits: 0=1bit; 1=1.5/2bit</description>
              <bitRange>[7:7]</bitRange>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Stop1</name>
                  <description>1 stop bit</description>
                  <value>0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Stop1_5_or_2</name>
                  <description>1.5 (5-bit data) or 2 stop bits</description>
                  <value>1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>DIV_H</name>
          <description>Baud rate divider high byte (write only when UART_CTL[div_en]=1 or UART not
            busy)</description>
          <addressOffset>0x0C</addressOffset>
          <size>16</size>
          <resetValue>0x0000</resetValue>
          <writeConstraint>
            <range>
              <minimum>0</minimum>
              <maximum>255</maximum>
            </range>
          </writeConstraint>
          <fields>
            <field>
              <name>div_h</name>
              <description>Divider integer high 8 bits</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DIV_L</name>
          <description>Baud rate divider low byte (write only when UART_CTL[div_en]=1 or UART not
            busy)</description>
          <addressOffset>0x10</addressOffset>
          <size>16</size>
          <resetValue>0x0000</resetValue>
          <writeConstraint>
            <range>
              <minimum>0</minimum>
              <maximum>255</maximum>
            </range>
          </writeConstraint>
          <fields>
            <field>
              <name>div_l</name>
              <description>Divider integer low 8 bits</description>
              <bitRange>[7:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>DIV_FRA</name>
          <description>Baud rate divider fractional part</description>
          <addressOffset>0x14</addressOffset>
          <size>16</size>
          <resetValue>0x0000</resetValue>
          <fields>
            <field>
              <name>div_fra</name>
              <description>Divider fractional part (divided by 2^6)</description>
              <bitRange>[5:0]</bitRange>
              <access>read-write</access>
            </field>
          </fields>
        </register>
        <register>
          <name>INTR_EN</name>
          <description>Interrupt enable register</description>
          <addressOffset>0x18</addressOffset>
          <size>16</size>
          <resetValue>0x0000</resetValue>
          <fields>
            <field>
              <name>rece_line_stat_intr_en</name>
              <description>RX line status interrupt enable</description>
              <bitRange>[0:0]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>modem_intr_en</name>
              <description>Modem status interrupt enable</description>
              <bitRange>[1:1]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>rece_data_intr_en</name>
              <description>RX data available interrupt enable</description>
              <bitRange>[2:2]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>tran_em_intr_en</name>
              <description>TX empty interrupt enable</description>
              <bitRange>[3:3]</bitRange>
              <access>read-write</access>
            </field>
            <field>
              <name>ptim_en</name>
              <description>Programmable THRE interrupt mode enable</description>
